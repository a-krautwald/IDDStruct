<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="IDDStruct.Desktop.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:IDDStruct.Desktop.ViewModels"
    Title="IDDStruct">

    <Grid x:Name="Root">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Commands -->
        <CommandBar Grid.Row="0" DefaultLabelPosition="Right" HorizontalAlignment="Left" IsOpen="False">
            <AppBarButton Icon="Document" Label="New" Click="New_Click" />
            <AppBarButton Icon="OpenFile" Label="Import / Open" Click="Open_Click" />
            <AppBarButton Icon="Save" Label="Save" Click="Save_Click" />
            <AppBarButton Icon="SaveLocal" Label="Save as" Click="SaveAs_Click" />
            <AppBarButton Icon="Upload" Label="Export IDML" Click="Export_Click" />
            <AppBarSeparator />
            <AppBarButton Icon="Add" Label="Add block">
                <AppBarButton.Flyout>
                    <MenuFlyout Placement="Bottom">
                        <MenuFlyoutItem Text="Heading" Command="{x:Bind ViewModel.AddHeadingCommand}" />
                        <MenuFlyoutItem Text="Paragraph" Command="{x:Bind ViewModel.AddParagraphCommand}" />
                        <MenuFlyoutItem Text="Bullet item" Command="{x:Bind ViewModel.AddBulletCommand}" />
                        <MenuFlyoutItem Text="Numbered item" Command="{x:Bind ViewModel.AddNumberedCommand}" />
                        <MenuFlyoutItem Text="Table" Command="{x:Bind ViewModel.AddTableCommand}" />
                        <MenuFlyoutItem Text="Page break" Command="{x:Bind ViewModel.AddPageBreakCommand}" />
                    </MenuFlyout>
                </AppBarButton.Flyout>
            </AppBarButton>
            <AppBarButton Icon="Copy" Label="Duplicate" Command="{x:Bind ViewModel.DuplicateBlockCommand}" />
            <AppBarButton Label="Move up" Command="{x:Bind ViewModel.MoveUpCommand}">
                <AppBarButton.Icon><FontIcon Glyph="&#xE74A;" /></AppBarButton.Icon>
            </AppBarButton>
            <AppBarButton Label="Move down" Command="{x:Bind ViewModel.MoveDownCommand}">
                <AppBarButton.Icon><FontIcon Glyph="&#xE74B;" /></AppBarButton.Icon>
            </AppBarButton>
            <AppBarButton Icon="Delete" Label="Remove" Command="{x:Bind ViewModel.RemoveBlockCommand}" />
        </CommandBar>

        <!-- Document settings -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="16" Padding="16,4,16,12">
            <TextBox Header="Document title" Width="320"
                     Text="{x:Bind ViewModel.Title, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
            <ComboBox Header="Page size" Width="140"
                      ItemsSource="{x:Bind ViewModel.PageSizes}"
                      SelectedIndex="{x:Bind ViewModel.PageSizeIndex, Mode=TwoWay}" />
            <NumberBox Header="Columns" Width="120" Minimum="1" Maximum="12" SpinButtonPlacementMode="Inline"
                       Value="{x:Bind ViewModel.Columns, Mode=TwoWay}" />
        </StackPanel>

        <InfoBar x:Name="Notice" Grid.Row="2" Margin="16,0,16,8" IsOpen="False" IsClosable="True" />

        <!-- Outline and editor -->
        <Grid Grid.Row="3" Padding="16,0,16,8" ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="320" />
                <ColumnDefinition Width="420" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" CornerRadius="8" BorderThickness="1"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                <ListView x:Name="BlockList"
                          ItemsSource="{x:Bind ViewModel.Blocks}"
                          SelectedItem="{x:Bind ViewModel.SelectedBlock, Mode=OneWay}"
                          SelectionChanged="BlockList_SelectionChanged"
                          SelectionMode="Single"
                          CanDragItems="True" CanReorderItems="True" AllowDrop="True">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="vm:BlockViewModel">
                            <Grid Padding="{x:Bind Indent, Mode=OneWay}" ColumnSpacing="10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="40" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border CornerRadius="4" Padding="4,2" VerticalAlignment="Center"
                                        Background="{ThemeResource SubtleFillColorSecondaryBrush}">
                                    <TextBlock Text="{x:Bind Badge, Mode=OneWay}" HorizontalAlignment="Center"
                                               FontWeight="SemiBold" FontSize="12" />
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="{x:Bind Preview, Mode=OneWay}" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{x:Bind StyleName, Mode=OneWay}"
                                               Style="{StaticResource CaptionTextBlockStyle}"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Border>

            <Border Grid.Column="1" CornerRadius="8" BorderThickness="1"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                <Grid>
                    <TextBlock Text="Select a block to edit it, or import a file to get started."
                               TextWrapping="Wrap" Margin="24" HorizontalAlignment="Center" VerticalAlignment="Center"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               Visibility="{x:Bind NotVisible(ViewModel.HasSelection), Mode=OneWay}" />
                    <ScrollViewer Visibility="{x:Bind ViewModel.HasSelection, Mode=OneWay}">
                        <StackPanel Spacing="14" Padding="20">
                            <TextBlock Text="Block" Style="{StaticResource SubtitleTextBlockStyle}" />
                            <ComboBox Header="Type" HorizontalAlignment="Stretch"
                                      ItemsSource="{x:Bind ViewModel.BlockKindNames}"
                                      SelectedIndex="{x:Bind ViewModel.SelectedBlock.KindIndex, Mode=TwoWay, FallbackValue=-1}" />
                            <NumberBox Header="Level" Minimum="1" SpinButtonPlacementMode="Inline"
                                       Maximum="{x:Bind ViewModel.SelectedBlock.MaxLevel, Mode=OneWay, FallbackValue=6}"
                                       Value="{x:Bind ViewModel.SelectedBlock.Level, Mode=TwoWay, FallbackValue=1}"
                                       Visibility="{x:Bind ViewModel.SelectedBlock.HasLevel, Mode=OneWay, FallbackValue=Collapsed}" />
                            <TextBox Header="Paragraph style (leave empty for default)"
                                     PlaceholderText="{x:Bind ViewModel.SelectedBlock.DefaultStyleName, Mode=OneWay, FallbackValue=''}"
                                     Text="{x:Bind ViewModel.SelectedBlock.Style, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, FallbackValue=''}"
                                     Visibility="{x:Bind ViewModel.SelectedBlock.HasStyle, Mode=OneWay, FallbackValue=Collapsed}" />
                            <StackPanel Spacing="4" Visibility="{x:Bind ViewModel.SelectedBlock.IsText, Mode=OneWay, FallbackValue=Collapsed}">
                                <TextBox Header="Text" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="180"
                                         Text="{x:Bind ViewModel.SelectedBlock.Text, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, FallbackValue=''}" />
                                <TextBlock Style="{StaticResource CaptionTextBlockStyle}" TextWrapping="Wrap"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                           Text="Use **bold** and *italic*. A new line becomes a forced line break within the paragraph." />
                            </StackPanel>
                            <StackPanel Spacing="8" Visibility="{x:Bind ViewModel.SelectedBlock.IsTable, Mode=OneWay, FallbackValue=Collapsed}">
                                <TextBox Header="Table – one row per line, cells separated by | or tab"
                                         AcceptsReturn="True" TextWrapping="NoWrap" MinHeight="180"
                                         FontFamily="Consolas"
                                         Text="{x:Bind ViewModel.SelectedBlock.TableText, Mode=TwoWay, FallbackValue=''}" />
                                <NumberBox Header="Header rows" Minimum="0" Maximum="10" SpinButtonPlacementMode="Inline"
                                           Value="{x:Bind ViewModel.SelectedBlock.HeaderRows, Mode=TwoWay, FallbackValue=1}" />
                            </StackPanel>
                            <TextBlock Style="{StaticResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       Text="{x:Bind ViewModel.SelectedBlock.StyleName, Mode=OneWay, FallbackValue=''}" />
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>

        <!-- Status bar -->
        <TextBlock Grid.Row="4" Margin="16,4,16,10" Style="{StaticResource CaptionTextBlockStyle}"
                   Text="{x:Bind ViewModel.StatusText, Mode=OneWay}" />
    </Grid>
</Window>
